{
  "name": "opportunity-systems",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-sites.mjs",
    "monitor:demo": "node scripts/monitor-official-pages.mjs",
    "monitor:json": "node scripts/monitor-official-pages.mjs --json",
    "monitor:persist": "node scripts/monitor-official-pages.mjs --persist",
    "monitor:review": "node scripts/monitor-official-pages.mjs --review",
    "monitor:review:write": "node scripts/monitor-official-pages.mjs --review --write-review",
    "monitor:seed": "node scripts/export-monitoring-seed.mjs",
    "monitor:seed:write": "node scripts/export-monitoring-seed.mjs --write",
    "monitor:seed:sql": "node scripts/export-monitoring-seed.mjs --sql",
    "monitor:seed:sql:write": "node scripts/export-monitoring-seed.mjs --sql --write",
    "watch:seed:d1": "node scripts/export-d1-watch-seed.mjs",
    "watch:seed:d1:write": "node scripts/export-d1-watch-seed.mjs --write",
    "watch:seed:d1:sync": "node scripts/apply-d1-watch-seed.mjs",
    "watch:seed:d1:sync:dry": "node scripts/apply-d1-watch-seed.mjs --dry-run",
    "watch:worker:dev": "npx wrangler dev --config wrangler.watch.toml",
    "watch:worker:deploy": "npx wrangler deploy --config wrangler.watch.toml",
    "capture:worker:dev": "npx wrangler dev --config wrangler.capture.toml",
    "capture:worker:deploy": "npx wrangler deploy --config wrangler.capture.toml",
    "capture:d1:migrate": "npx wrangler d1 migrations apply applyfirst_beta --config wrangler.capture.toml --remote",
    "capture:smoke": "node scripts/smoke-capture-endpoints.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
